## Machine-specific configs
Include config.d/*

## General config
Host *
     IgnoreUnknown UseKeychain
     UseKeychain yes
     AddKeysToAgent yes
     ServerAliveInterval 120

## Git@LNS access
Host usqcd-git
     HostName usqcd.lns.mit.edu
     User gitolite
     ForwardAgent no
     IdentitiesOnly yes
     HostKeyAlgorithms +ssh-rsa
     PubkeyAcceptedKeyTypes +ssh-rsa
     IdentityFile ~/.ssh/id_rsa

## Wombat
Host wombat
     HostName wombat.mit.edu
     User gurtej
     LocalForward 22692 localhost:22692
Host wombat_proxy
     HostName wombat.mit.edu
     User gurtej
     ProxyJump submit.mit.edu
     LocalForward 22692 localhost:22692
Host wombat2_proxy
     HostName orcd-login.mit.edu
     ControlMaster auto
     ControlPath ~/.ssh/%r@%h:%p
     ControlPersist 300s
     User gurtej
     ProxyJump submit.mit.edu
Host wallaby
     HostName wallaby.mit.edu
     User gurtej

## submit
Host submit.mit.edu
     User gurtej
     ForwardAgent yes

